{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Win32 Release",
            "type": "shell",
            "command": "${workspaceFolder}\\_build_win32_release.bat",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build x64 Release",
            "type": "shell",
            "command": "${workspaceFolder}\\_build_x64_release.bat",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$msCompile"
        }
    ]
}
